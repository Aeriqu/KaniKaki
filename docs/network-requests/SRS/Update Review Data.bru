meta {
  name: Update Review Data
  type: graphql
  seq: 3
}

post {
  url: http://localhost/api
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{AUTH_TOKEN}}
}

body:graphql {
  mutation {
    updateReviewData(identifier: "testUser", subject: "kanji", topic: "俸", level: 1, reviewTime: 1751676779) {
      Topic
      Subject
      Level
      ReviewTime
    }
  }
}
